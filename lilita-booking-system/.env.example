# ============================================================================
# LILITA KEPER BOOKING SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=lilita_booking

# For Production (Railway)
# DB_HOST=your-railway-postgres-host
# DB_PASSWORD=your-railway-db-password

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
PORT=3002

# For Production
# NODE_ENV=production
# PORT=3002

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# ============================================================================
# STRIPE PAYMENT (optional, for future payment integration)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# PESAPAL / M-PESA (optional, for future payment integration)
# ============================================================================
PESAPAL_API_KEY=your_pesapal_api_key
PESAPAL_SECRET_KEY=your_pesapal_secret_key
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret

# ============================================================================
# EMAIL SERVICE (optional, for campaign emails)
# ============================================================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@lilitakeper.com

# ============================================================================
# CORS & DEPLOYMENT
# ============================================================================
# For Development
FRONTEND_URL=http://localhost:5173

# For Production
# FRONTEND_URL=https://your-app-domain.com
